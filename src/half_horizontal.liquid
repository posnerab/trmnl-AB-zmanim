<div class="layout layout--col gap--small">
  <div class="flex flex--row flex--between w--full"><span class="label label--inverted">ZMANIM</span><span class="label label--small">{{ display_hdate | escape }} · <span dir="rtl">{{ hdate_hebrew | escape }}</span></span></div>
  <div class="grid grid--cols-3 w--full">
    <div class="flex flex--col gap--small text--center">
      <span class="label label--small">NEXT ZMAN</span>
      <span class="value value--large value--tnums" data-fit-value="true">{{ next_zman[1] | default: '—' }}</span>
      <div class="flex flex--row gap--small">{{ next_icon }}<span class="label">{{ next_zman[0] | escape }}</span></div>
    </div>
    <div class="flex flex--col gap--small text--center">
      <span class="label label--small">THIS SHABBOS</span>
      <span class="title">{{ parasha_english | escape }}</span>
      <span class="title" dir="rtl">{{ parasha_hebrew | escape }}</span>
      {% if special_shabbos != blank %}<span class="label label--small">{{ special_shabbos | escape }}</span>{% endif %}
    </div>
    <div class="outline p--2 flex flex--col gap--small text--center">
      <span class="label label--small">ON THE HORIZON</span>
      <span class="title">{{ holiday.name | default: 'Calendar unavailable' | escape }}</span>
      <span class="label label--outline">{{ holiday.detail | escape }}</span>
    </div>
  </div>
</div>
<div class="title_bar"><span class="title">{{ period | escape }}</span><span class="instance">{{ current_time }} · Hebcal / CBJ</span></div>
