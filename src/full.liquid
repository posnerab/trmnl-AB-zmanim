<div class="layout layout--col gap--medium">
  <div class="flex flex--row flex--between w--full">
    <span class="label label--inverted">ZMANIM · {{ period | escape }}</span>
    <span class="label">{{ display_hdate | escape }} · <span dir="rtl">{{ hdate_hebrew | escape }}</span></span>
  </div>
  <div class="flex flex--row flex--between w--full border--bottom pb--2">
    <div class="flex flex--col flex--left gap--small">
      <span class="label label--small">THIS SHABBOS</span>
      <span class="title title--large">{{ parasha_english | escape }}</span>
    </div>
    <div class="flex flex--col flex--right gap--small">
      <span class="title title--large" dir="rtl">{{ parasha_hebrew | escape }}</span>
      {% if special_shabbos != blank %}<span class="label label--small">{{ special_shabbos | escape }}</span>{% endif %}
    </div>
  </div>
  <div class="grid grid--cols-3 w--full">
    <div class="col--span-2 flex flex--row gap--medium">
      {{ next_icon }}
      <div class="flex flex--col flex--left gap--small">
        <span class="label label--small">NEXT ZMAN</span>
        <span class="value value--xxlarge value--tnums" data-fit-value="true">{{ next_zman[1] | default: '—' }}</span>
        <span class="title">{{ next_zman[0] | default: 'No upcoming zman' | escape }}</span>
      </div>
    </div>
    <div class="outline p--3 flex flex--col gap--small text--center">
      <span class="label label--small">ON THE HORIZON</span>
      {% if holiday %}
        <span class="title">{{ holiday.name | escape }}</span>
        {% if holiday.days > 0 %}<span class="value value--large" data-fit-value="true">{{ holiday.days }}</span><span class="label">days to go</span>
        {% else %}<span class="title">{{ holiday.detail | escape }}</span>{% endif %}
      {% else %}<span class="label">Calendar unavailable</span>{% endif %}
    </div>
  </div>
  <div class="grid grid--cols-3 w--full border--top pt--2">
    {% for zman in zman_rows limit:6 %}
      <div class="item">
        <div class="meta">{{ zman.icon }}</div>
        <div class="content"><span class="value value--xsmall value--tnums" data-fit-value="true">{{ zman.time }}</span><span class="label label--small">{{ zman.name | escape }}</span></div>
      </div>
    {% endfor %}
  </div>
</div>
<div class="title_bar"><span class="title">{{ location | escape }}</span><span class="instance">{{ date | escape }} · {{ current_time }} · Hebcal / CBJ</span></div>
