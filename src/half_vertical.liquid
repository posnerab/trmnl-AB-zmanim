<div class="layout layout--col gap--small text--center">
  <span class="label label--inverted">ZMANIM · {{ period | escape }}</span>
  <span class="label label--small">{{ display_hdate | escape }} · <span dir="rtl">{{ hdate_hebrew | escape }}</span></span>
  <div class="flex flex--col gap--small w--full border--h py--1">
    <span class="title">{{ parasha_english | escape }}</span>
    <span class="title" dir="rtl">{{ parasha_hebrew | escape }}</span>
    {% if special_shabbos != blank %}<span class="label label--small">{{ special_shabbos | escape }}</span>{% endif %}
  </div>
  <div class="flex flex--row gap--small">{{ next_icon }}<span class="label">NEXT ZMAN</span></div>
  <span class="value value--large value--tnums" data-fit-value="true">{{ next_zman[1] | default: '—' }}</span>
  <span class="title">{{ next_zman[0] | default: 'No upcoming zman' | escape }}</span>
  {% if holiday %}<div class="outline p--2 w--full"><span class="title">{{ holiday.name | escape }}</span><span class="label"> · {{ holiday.detail | escape }}</span></div>{% endif %}
</div>
<div class="title_bar"><span class="title">Zmanim</span><span class="instance">{{ current_time }} · Hebcal / CBJ</span></div>
